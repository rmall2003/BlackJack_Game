*.swp
*~ 
*.bak

# Coverage reports
htmlcov/
.coverage
.coverage.*

# Packaging
pip-wheel-metadata/
wheelhouse/

# Optional: ignore built executables (PyInstaller artifacts)
dist/
build/
*.spec
