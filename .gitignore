Thumbs.db
desktop.ini

# Logs and local databases
*.log
*.sqlite3

# Python env files
.env
.env.*.local

# Bytecode / cache
*.cache
*.mypy_cache/

# Pygame / assets (usually you WANT assets tracked, so this is commented out)
